# Canonical website URL used for Stripe success/cancel redirects.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Stripe: use credentials from the same account/mode as your ticket Price IDs.
STRIPE_SECRET_KEY=replace_with_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=replace_with_your_stripe_webhook_secret

# Stripe-hosted promotion. Register the code once with stripe:promo:setup -- --apply.
# Customers enter the code on Stripe. The fixed $100 discount applies once per order.
DOMINION_PROMO_CODE=DOMINION100
DOMINION_PROMO_ENABLED=true

# Existing registration and email services (server-only).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace_with_your_supabase_secret_key
RESEND_API_KEY=replace_with_your_resend_api_key
EMAIL_FROM=DOMINION <tickets@yourdomain.com>
ORGANIZER_EMAIL=organizer@yourdomain.com

# Optional existing email/venue configuration.
# RESEND_FROM_EMAIL=DOMINION <tickets@yourdomain.com>
# DOMINION_VENUE_NAME=
# DOMINION_VENUE_ADDRESS=
# DOMINION_LOGO_URL=
# HOTEL_BOOKING_URL=
